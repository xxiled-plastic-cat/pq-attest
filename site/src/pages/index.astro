    </section>

    <section class="section" id="why" aria-labelledby="why-title">
      <div class="container">
        <p class="section-label">Why it lasts</p>
        <h2 id="why-title">
          A record that does not depend on today’s signatures.
        </h2>
        <div class="prose-grid">
          <article>
            <h3>Falcon, on the ledger</h3>
            <p>
              Algorand checks the attestation with Falcon, a post-quantum
              signature. The on-chain record does not rest on a key a large
              quantum computer is expected to forge.
            </p>
          </article>
          <article>
            <h3>A fingerprint that stays</h3>
            <p>
              The attestation carries a SHA-256 fingerprint of the confirmed
              transaction. Anyone can fetch the original, recompute the
              fingerprint, and compare.
            </p>
          </article>
          <article>
            <h3>Yours to verify</h3>
            <p>
              The bundle is signed with ML-DSA over the fingerprint, the ledger
              entry, and the attestor. You need the bundle and a public key. You
              do not need to trust us forever.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="proof-bundle" aria-labelledby="bundle-title">
      <div class="container">
        <p class="section-label">The proof</p>
        <h2 id="bundle-title">What you receive.</h2>
        <p class="section-intro">
          One document. It names the transaction, its fingerprint, the ledger
          entry that records it, and a signature over all of that. There is no
          extra state proof. The chain is the record.
        </p>

        <figure class="code-figure">
          <figcaption>
            <span>proof-bundle.json</span>
            <span class="sample-tag">Sample · shortened</span>
          </figcaption>
          <pre tabindex="0"><code set:html={sampleBundle} /></pre>
        </figure>

        <dl class="field-notes">
          <div>
            <dt>Fingerprint</dt>
            <dd>
              A SHA-256 hash of the confirmed transaction. Recompute it from the
              bytes in the bundle.
            </dd>
          </div>
          <div>
            <dt>Ledger entry</dt>
            <dd>
              A confirmed transaction whose note carries that fingerprint.
            </dd>
          </div>
          <div>
            <dt>Signature</dt>
            <dd>
              ML-DSA-65, checked with the attestor’s published public key.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section" id="integrate" aria-labelledby="integrate-title">
      <div class="container">
        <p class="section-label">Using it</p>
        <h2 id="integrate-title">Start at the MCP.</h2>
        <div class="prose-grid two">
          <article>
            <h3>Remote MCP</h3>
            <p>
              This is the first door for agents and for clients. Connect to{" "}
              <a href="#mcp-address">{links.mcp}</a>. Call{" "}
              <code>pq_attest</code> for a proof, or <code>pq_verify</code> to check
              one. The server forwards both to the API. It does not sign, settle,
              or hold keys.
            </p>
          </article>
          <article>
            <h3>The API</h3>
            <p>
              The API is the source behind the MCP. Call it directly when you
              speak HTTP, or run the reference implementation against your own
              node. A new attestation costs <span data-attest-price
                >the published price</span
              >, paid through <a href={links.x402}>x402</a> on Algorand, Base, or
              Solana. Every attestation is recorded on Algorand.{" "}
              <a href={links.contact}>Contact us</a> about an integration.
            </p>
          </article>
        </div>

        <ul class="offers">
          <li>
            <span class="offer-name">Request an attestation</span>
            <span class="offer-detail"
              >A confirmed transaction id in, paid through x402. A signed proof
              out.</span
            >
            <span class="offer-access" data-attest-price>x402</span>
          </li>
          <li>
            <span class="offer-name">Check a proof</span>
            <span class="offer-detail"
              >Confirm the fingerprint and the signature. Optionally, re-check
              the chain.</span
            >
            <span class="offer-access">Free</span>
          </li>
          <li>
            <span class="offer-name">Read the description</span>
            <span class="offer-detail"
              >x402 payment terms, for the MCP and for the API.</span
            >
            <span class="offer-access">Free</span>
          </li>
        </ul>
        <p class="base-url" id="mcp-address">MCP address: {links.mcp}</p>
        <p class="base-url">API address: {links.apiBase}</p>
      </div>
    </section>
  </main>
  <script>
    import { discoveryUrl } from "../data/site";

    const slots = document.querySelectorAll<HTMLElement>("[data-attest-price]");

    function priceLabel(accepts: { priceUsdc?: string }[]): string | null {
      const prices = [
        ...new Set(
          accepts
            .map((accept) => accept.priceUsdc?.trim())
            .filter((price): price is string => Boolean(price)),
        ),
      ];
      if (prices.length === 0) return null;
      return prices.map((price) => `${price} USDC`).join(" · ");
    }

    fetch(discoveryUrl)
      .then((response) => {
        if (!response.ok) throw new Error(String(response.status));
        return response.json() as Promise<{
          accepts?: { priceUsdc?: string }[];
        }>;
      })
      .then((doc) => {
        const label = priceLabel(doc.accepts ?? []);
        if (!label) return;
        // Hold the swap until the hero has finished rising in, so the flash
        // that marks the live price reads as its own moment.
        const wait = Math.max(0, 950 - performance.now());
        window.setTimeout(() => {
          for (const slot of slots) {
            slot.textContent = label;
            slot.dataset.priceState = "loaded";
          }
        }, wait);
      })
      .catch(() => {});

    // The sample fingerprint resolves from hex noise to its real value,
    // one character at a time from the left.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const target = document.querySelector<HTMLElement>("[data-scramble]");

    if (target && !reduceMotion) {
      const final = target.textContent ?? "";
      const HEX = "0123456789abcdef";
      const isHex = (ch: string) => HEX.includes(ch);
      const start = 700; // after the fingerprint row has risen in
      const duration = 900;
      let began = 0;

      const frame = (now: number) => {
        if (!began) began = now;
        const t = Math.min(1, (now - began) / duration);
        const eased = 1 - (1 - t) * (1 - t);
        const settled = Math.floor(eased * final.length);
        let out = "";
        for (let i = 0; i < final.length; i++) {
          const ch = final[i];
          out +=
            i < settled || !isHex(ch)
              ? ch
              : HEX[Math.floor(Math.random() * 16)];
        }
        target.textContent = out;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          target.textContent = final;
          target.dataset.state = "settled";
        }
      };

      window.setTimeout(() => {
        target.dataset.state = "running";
        requestAnimationFrame(frame);
      }, start);
    }
  </script>
</Base>
