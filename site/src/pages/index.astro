---
import Base from "../layouts/Base.astro";
import { discoveryUrl, links, openApiUrl } from "../data/site";

const title = "PQ Attest — Post-quantum transaction attestation on Algorand";
const description =
  "Fingerprint a transaction from any supported chain, record it on Algorand, and get an ML-DSA-65 proof you can check yourself.";

const sampleBundle = `{
  <span class="k">"version"</span>: <span class="n">1</span>,
  <span class="k">"network"</span>: <span class="s">"algorand-mainnet"</span>,
  <span class="k">"source"</span>: {
    <span class="k">"txnId"</span>: <span class="s">"J6GYUX7M22Z65EEV6U4QTKM6QD6D5XHWRXRBU6BM7O3STNI7S7JA"</span>,
    <span class="k">"hashSha256"</span>: <span class="s">"61b62b38c65ec66ea2638d49926dbd16b0b344c1fc3ee30a69f8ade02a2a2cd3"</span>
  },
  <span class="k">"attest"</span>: {
    <span class="k">"txnId"</span>: <span class="s">"F732JQ5WWC3IXEPVNEEEBOE2LBWBS6EMZM5G2XCXTBGIFFT37CJA"</span>,
    <span class="k">"round"</span>: <span class="n">65330479</span>,
    <span class="k">"note"</span>: <span class="s">"fingerprint of the source transaction"</span>
  },
  <span class="k">"attestor"</span>: {
    <span class="k">"algorandAddress"</span>: <span class="s">"EVG4CYNYGIDNDIDJTUDJU7ELJQJBNAJA6UZAQJO54XCL5SKKM6IR33PQJE"</span>,
    <span class="k">"pqPublicKey"</span>: <span class="s">"3rO9EVFuGb9iUL1kiE9f6eF/5bGu22e3qNn5PSj2tkCvfQPH…"</span>
  },
  <span class="k">"signature"</span>: {
    <span class="k">"alg"</span>: <span class="s">"ML-DSA-65"</span>,
    <span class="k">"sigBase64"</span>: <span class="s">"hgUwnwK1srDBLPJQGiWNm6g5oQmGC0AyR6iOoYANEN71I4xq…"</span>
  }
}`;
---

<Base title={title} description={description}>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Post-quantum attestation for any transaction.</h1>
          <p class="lede">
            PQ Attest writes a fingerprint of a confirmed transaction from any
            chain onto Algorand’s quantum-secure ledger and returns a proof you
            can verify independently. A new attestation costs <span
              data-attest-price>the published price</span
            >, paid through <a href={links.x402}>x402</a> on any chain the service
            accepts. Agents and clients start at the remote MCP. The API is the source
            behind it. Checking a proof is free.
          </p>
          <div class="cta-row">
            <a class="button button-primary" href="#integrate"
              >Use the MCP<span
                class="button-arrow"
                data-direction="down"
                aria-hidden="true">↓</span
              ></a
            >
            <a class="button button-secondary" href="#how-it-works"
              >How it works<span
                class="button-arrow"
                data-direction="down"
                aria-hidden="true">↓</span
              ></a
            >
            <a href={openApiUrl}>View the API</a>
          </div>
        </div>

        <aside class="slip" aria-label="Sample proof">
          <p class="slip-kicker"><span>Sample</span></p>
          <dl>
            <div>
              <dt>Network</dt>
              <dd>Algorand MainNet</dd>
            </div>
            <div>
              <dt>Transaction</dt>
              <dd>J6GYUX7M…S7JA</dd>
            </div>
            <div>
              <dt>Fingerprint</dt>
              <dd>
                <span class="visually-hidden">61b62b38…2cd3</span>
                <span aria-hidden="true" data-scramble>61b62b38…2cd3</span>
              </dd>
            </div>
            <div>
              <dt>Recorded</dt>
              <dd>Round 65,330,479</dd>
            </div>
            <div>
              <dt>Signed with</dt>
              <dd>ML-DSA-65</dd>
            </div>
          </dl>
        </aside>
      </div>

      <div class="container">
        <dl class="facts">
          <div>
            <dt>Ledger</dt>
            <dd>Algorand MainNet</dd>
          </div>
          <div>
            <dt>On-chain signature</dt>
            <dd>Falcon-1024</dd>
          </div>
          <div>
            <dt>Proof signature</dt>
            <dd>ML-DSA-65</dd>
          </div>
          <div>
            <dt>Fingerprint</dt>
            <dd>SHA-256</dd>
          </div>
          <div>
            <dt>Payment</dt>
            <dd><span data-attest-price>x402</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section" id="how-it-works" aria-labelledby="how-title">
      <div class="container">
        <p class="section-label">How it works</p>
        <h2 id="how-title">Five steps, from an id to a proof.</h2>
        <ol class="steps">
          <li>
            <span class="step-index" aria-hidden="true">01</span>
            <div>
              <h3>Submit</h3>
              <p>
                Send the id of a transaction that has already confirmed. The id
                can be from any supported chain.
              </p>
            </div>
          </li>
          <li>
            <span class="step-index" aria-hidden="true">02</span>
            <div>
              <h3>Pay</h3>
              <p>
                Pay <span data-attest-price>the published price</span> through <a
                  href={links.x402}>x402</a
                >, on any chain the service accepts. The first request returns
                the payment terms. Complete them and send the same id again.
              </p>
            </div>
          </li>
          <li>
            <span class="step-index" aria-hidden="true">03</span>
            <div>
              <h3>Fingerprint</h3>
              <p>
                The full confirmed record is fingerprinted, including inner
                transactions and confirmation details. Nothing is dropped.
              </p>
            </div>
          </li>
          <li>
            <span class="step-index" aria-hidden="true">04</span>
            <div>
              <h3>Record</h3>
              <p>
                A post-quantum account writes that fingerprint into the ledger.
                Once confirmed, it is part of Algorand’s history, not something
                we store for you.
              </p>
            </div>
          </li>
          <li>
            <span class="step-index" aria-hidden="true">05</span>
            <div>
              <h3>Prove</h3>
              <p>
                You receive a signed bundle. Check it on the chain, or offline,
                with a published key. The proof still holds if this service goes
                away.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section chains-section" id="chains" aria-labelledby="chains-title">
      <div class="container">
        <h2 class="section-label" id="chains-title">Supported chains</h2>
        <ul class="chains">
          <li>
            <svg class="chain-logo" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M13.874 0h3.673l1.61 5.963h3.789l-2.588 4.5 3.624 13.533h-3.757l-2.44-9.077-5.247 9.079H8.345l8.107-14.051-1.304-4.878L4.215 24H.018Z"
              ></path>
            </svg>
            <span class="chain-name">Algorand</span>
          </li>
          <li>
            <svg class="chain-logo chain-logo-base" viewBox="0 0 146 146" aria-hidden="true">
              <path
                fill="#0052FF"
                d="M73 146C113.317 146 146 113.317 146 73S113.317 0 73 0C34.69 0 3.13 29.466 0 66.862h96.727v12.276H0C3.13 116.533 34.69 146 73 146Z"
              ></path>
            </svg>
            <span class="chain-name">Base</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="why" aria-labelledby="why-title">
      <div class="container">
        <p class="section-label">Why it lasts</p>
        <h2 id="why-title">
          A record that does not depend on today’s signatures.
        </h2>
        <div class="prose-grid">
          <article>
            <h3>Falcon, on the ledger</h3>
            <p>
              Algorand checks the attestation with Falcon, a post-quantum
              signature. The on-chain record does not rest on a key a large
              quantum computer is expected to forge.
            </p>
          </article>
          <article>
            <h3>A fingerprint that stays</h3>
            <p>
              The attestation carries a SHA-256 fingerprint of the confirmed
              transaction. Anyone can fetch the original, recompute the
              fingerprint, and compare.
            </p>
          </article>
          <article>
            <h3>Yours to verify</h3>
            <p>
              The bundle is signed with ML-DSA over the fingerprint, the ledger
              entry, and the attestor. You need the bundle and a public key. You
              do not need to trust us forever.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="proof-bundle" aria-labelledby="bundle-title">
      <div class="container">
        <p class="section-label">The proof</p>
        <h2 id="bundle-title">What you receive.</h2>
        <p class="section-intro">
          One document. It names the transaction, its fingerprint, the ledger
          entry that records it, and a signature over all of that. There is no
          extra state proof. The chain is the record.
        </p>

        <figure class="code-figure">
          <figcaption>
            <span>proof-bundle.json</span>
            <span class="sample-tag">Sample · shortened</span>
          </figcaption>
          <pre tabindex="0"><code set:html={sampleBundle} /></pre>
        </figure>

        <dl class="field-notes">
          <div>
            <dt>Fingerprint</dt>
            <dd>
              A SHA-256 hash of the confirmed transaction. Recompute it from the
              bytes in the bundle.
            </dd>
          </div>
          <div>
            <dt>Ledger entry</dt>
            <dd>
              A confirmed transaction whose note carries that fingerprint.
            </dd>
          </div>
          <div>
            <dt>Signature</dt>
            <dd>
              ML-DSA-65, checked with the attestor’s published public key.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section" id="integrate" aria-labelledby="integrate-title">
      <div class="container">
        <p class="section-label">Using it</p>
        <h2 id="integrate-title">Start at the MCP.</h2>
        <div class="prose-grid two">
          <article>
            <h3>Remote MCP</h3>
            <p>
              This is the first door for agents and for clients. Connect to{" "}
              <a href="#mcp-address">{links.mcp}</a>. Call{" "}
              <code>pq_attest</code> for a proof, or <code>pq_verify</code> to check
              one. The server forwards both to the API. It does not sign, settle,
              or hold keys.
            </p>
          </article>
          <article>
            <h3>The API</h3>
            <p>
              The API is the source behind the MCP. Call it directly when you
              speak HTTP, or run the reference implementation against your own
              node. A new attestation costs <span data-attest-price
                >the published price</span
              >, paid through <a href={links.x402}>x402</a>. USDC can be paid on
              any supported chain, all attestations take place on Algorand.{" "}
              <a href={links.contact}>Contact us</a> about an integration.
            </p>
          </article>
        </div>

        <ul class="offers">
          <li>
            <span class="offer-name">Request an attestation</span>
            <span class="offer-detail"
              >A confirmed transaction id in, paid through x402. A signed proof
              out.</span
            >
            <span class="offer-access" data-attest-price>x402</span>
          </li>
          <li>
            <span class="offer-name">Check a proof</span>
            <span class="offer-detail"
              >Confirm the fingerprint and the signature. Optionally, re-check
              the chain.</span
            >
            <span class="offer-access">Free</span>
          </li>
          <li>
            <span class="offer-name">Read the description</span>
            <span class="offer-detail"
              >x402 payment terms, for the MCP and for the API.</span
            >
            <span class="offer-access">Free</span>
          </li>
        </ul>
        <p class="base-url" id="mcp-address">MCP address: {links.mcp}</p>
        <p class="base-url">API address: {links.apiBase}</p>
      </div>
    </section>
  </main>
  <script>
    import { discoveryUrl } from "../data/site";

    const slots = document.querySelectorAll<HTMLElement>("[data-attest-price]");

    function priceLabel(accepts: { priceUsdc?: string }[]): string | null {
      const prices = [
        ...new Set(
          accepts
            .map((accept) => accept.priceUsdc?.trim())
            .filter((price): price is string => Boolean(price)),
        ),
      ];
      if (prices.length === 0) return null;
      return prices.map((price) => `${price} USDC`).join(" · ");
    }

    fetch(discoveryUrl)
      .then((response) => {
        if (!response.ok) throw new Error(String(response.status));
        return response.json() as Promise<{
          accepts?: { priceUsdc?: string }[];
        }>;
      })
      .then((doc) => {
        const label = priceLabel(doc.accepts ?? []);
        if (!label) return;
        // Hold the swap until the hero has finished rising in, so the flash
        // that marks the live price reads as its own moment.
        const wait = Math.max(0, 950 - performance.now());
        window.setTimeout(() => {
          for (const slot of slots) {
            slot.textContent = label;
            slot.dataset.priceState = "loaded";
          }
        }, wait);
      })
      .catch(() => {});

    // The sample fingerprint resolves from hex noise to its real value,
    // one character at a time from the left.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const target = document.querySelector<HTMLElement>("[data-scramble]");

    if (target && !reduceMotion) {
      const final = target.textContent ?? "";
      const HEX = "0123456789abcdef";
      const isHex = (ch: string) => HEX.includes(ch);
      const start = 700; // after the fingerprint row has risen in
      const duration = 900;
      let began = 0;

      const frame = (now: number) => {
        if (!began) began = now;
        const t = Math.min(1, (now - began) / duration);
        const eased = 1 - (1 - t) * (1 - t);
        const settled = Math.floor(eased * final.length);
        let out = "";
        for (let i = 0; i < final.length; i++) {
          const ch = final[i];
          out +=
            i < settled || !isHex(ch)
              ? ch
              : HEX[Math.floor(Math.random() * 16)];
        }
        target.textContent = out;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          target.textContent = final;
          target.dataset.state = "settled";
        }
      };

      window.setTimeout(() => {
        target.dataset.state = "running";
        requestAnimationFrame(frame);
      }, start);
    }
  </script>
</Base>
