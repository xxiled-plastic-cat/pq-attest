{
  "name": "pq-attest-experiment",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "experiments.pqattest.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BITCOIN_BLOCK_RUN",
        "class_name": "BitcoinBlockRun"
      },
      {
        "name": "ETHEREUM_BLOCK_RUN",
        "class_name": "EthereumBlockRun"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BitcoinBlockRun"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EthereumBlockRun"]
    }
  ],
  "vars": {
    "EXPERIMENT_RUN": "stop",
    // Bump EXPERIMENT_EPOCH to discard the stored run and open a new 24 hour window.
    "EXPERIMENT_EPOCH": "2026-10-16b",
    // stop, test (30 paid blocks), or start (6 hour window). Set this to start and redeploy to open the window.
    "ETHEREUM_EXPERIMENT_RUN": "stop",
    // 2026-10-19 is the finished 30-block test. This epoch is the empty 6-hour run.
    "ETHEREUM_EXPERIMENT_EPOCH": "2026-10-19b",
    "API_URL": "https://api.pqattest.com",
    "BITCOIN_API_URL": "https://mempool.space/api",
    "ETH_RPC_URL": "https://ethereum.publicnode.com",
    "ALGOD_URL": "https://mainnet-api.algonode.network/",
    "INDEXER_URL": "https://mainnet-idx.algonode.network/"
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "BITCOIN_BLOCK_RUN",
          "class_name": "BitcoinBlockRun"
        },
        {
          "name": "ETHEREUM_BLOCK_RUN",
          "class_name": "EthereumBlockRun"
        }
      ]
    },
    "vars": {
      "EXPERIMENT_RUN": "stop",
      "EXPERIMENT_EPOCH": "preview",
      "ETHEREUM_EXPERIMENT_RUN": "stop",
      "ETHEREUM_EXPERIMENT_EPOCH": "preview",
      "API_URL": "https://api.pqattest.com",
      "BITCOIN_API_URL": "https://mempool.space/api",
      "ETH_RPC_URL": "https://ethereum.publicnode.com",
      "ALGOD_URL": "https://mainnet-api.algonode.network/",
      "INDEXER_URL": "https://mainnet-idx.algonode.network/"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
