{
  "name": "pq-attest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI proof-of-concept for Algorand MainNet transaction attestation with an ML-DSA-65 proof bundle.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "attest": "node bin/attest.ts",
    "verify": "node bin/verify.ts",
    "verify:block": "node packages/verify/bin/verify-block.ts",
    "generate:ed25519": "node bin/generate-ed25519.ts",
    "generate:pq": "node bin/generate-pq.ts",
    "start": "node src/server.ts",
    "stats:dry": "node bin/stats.ts --dry",
    "stats:publish": "node bin/stats.ts",
    "deploy": "wrangler deploy && npm run stats:publish",
    "site": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "mcp:dev": "npm --prefix mcp-worker run dev",
    "mcp:test": "npm --prefix mcp-worker test",
    "mcp:typecheck": "npm --prefix mcp-worker run typecheck",
    "mcp:deploy": "npm --prefix mcp-worker run deploy",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "9.2.2",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "0.7.1",
    "algosdk": "3.8.0",
    "falcon-1024": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  }
}
