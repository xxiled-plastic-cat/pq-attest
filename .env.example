ALGOD_URL=https://mainnet-api.algonode.cloud/
ALGOD_TOKEN=
INDEXER_URL=https://mainnet-idx.algonode.cloud/
INDEXER_TOKEN=

# Source chain endpoints. Defaults are public and may rate-limit.
# BASE_RPC_URL=https://mainnet.base.org
# ETH_RPC_URL=https://ethereum.publicnode.com
# POLYGON_RPC_URL=https://polygon-bor.publicnode.com
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BITCOIN_API_URL=https://mempool.space/api
# APTOS_API_URL=https://fullnode.mainnet.aptoslabs.com/v1
# SUI_RPC_URL=https://fullnode.mainnet.sui.io
# HEDERA_API_URL=https://mainnet-public.mirrornode.hedera.com
# STELLAR_API_URL=https://horizon.stellar.org
# NEAR_API_URL=https://api.nearblocks.io/v1
# TON_API_URL=https://tonapi.io/v2

# 25-word ed25519 mnemonic. The ML-DSA-65 proof key is derived from this when
# ATTESTOR_PQ_SEED is unset. This account does not send the attestation transaction.
ATTESTOR_MNEMONIC=

# 48-byte hex seedHex from `npm run generate:pq`. This Falcon-1024 account sends
# the 0 ALGO attestation transaction. Fund the printed address on MainNet above
# the minimum balance; the Falcon signature fee is 3000 microAlgo.
ATTESTOR_FALCON_SEED=

# Optional 32-byte hex seed for the ML-DSA-65 proof key. When unset, the key is
# derived from ATTESTOR_MNEMONIC.
# ATTESTOR_PQ_SEED=

# x402 paywall. The API reads these directly.
# X402_PAY_TO is the Algorand address that receives USDC. POST /attest returns
# 500 while it is empty. Never put a payer mnemonic here.
X402_PAY_TO=
# Base address that receives USDC when a caller pays on Base. Required only for
# that rail. A Base source can still be paid with Algorand USDC via X402_PAY_TO.
# X402_PAY_TO_BASE=
X402_PRICE_ATTEST_USDC=0.001
X402_NETWORK=algorand-mainnet
X402_SCHEME=exact
FACILITATOR_URL=https://facilitator.goplausible.xyz
# CDP production facilitator for Base USDC (eip155:8453).
FACILITATOR_URL_BASE=https://api.cdp.coinbase.com/platform/v2/x402
